# ============================================
# Advanced RAG Platform - Environment Config
# ============================================

# Application
APP_NAME="Advanced RAG Platform"
APP_VERSION="1.0.0"
APP_ENV="production"
DEBUG=false
SECRET_KEY="your-secret-key-change-in-production"

# Server
HOST="0.0.0.0"
PORT=8000
WORKERS=2

# ── Groq API (Free) ─────────────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama3-8b-8192"
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.1

# ── Embeddings (Free local model) ───────────────
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64

# ── Vector Store ────────────────────────────────
FAISS_INDEX_PATH="./data/processed/faiss_index"
FAISS_INDEX_DIMENSION=384

# ── Retrieval Settings ──────────────────────────
RETRIEVAL_TOP_K=5
HYBRID_SEARCH_ALPHA=0.5
SIMILARITY_THRESHOLD=0.3
MAX_CONTEXT_TOKENS=4096
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RERANKER_ENABLED=true
RERANKER_TOP_N=3

# ── Database (SQLite for simplicity) ────────────
DATABASE_URL="sqlite+aiosqlite:///./data/rag.db"

# ── Document Processing ─────────────────────────
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=".pdf,.docx,.txt,.md,.html"

# ── Logging ─────────────────────────────────────
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# ── CORS ────────────────────────────────────────
ALLOWED_ORIGINS="*"
